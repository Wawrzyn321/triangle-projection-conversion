          "attributes": {
            "arn": "arn:aws:cloudfront::187949932559:function/site-canonical-function",
            "code": "function handler(event) {\n    var request = event.request;\n    var host = request.headers.host.value;\n\n    if (host === \"www.3d-projection-lab.com\") {\n        return {\n            statusCode: 301,\n            statusDescription: \"Moved Permanently\",\n            headers: {\n                location: { value: \"https://3d-projection-lab.com\" + request.uri }\n            }\n        };\n    }\n\n    return request;\n}",
            "comment": "Redirect www.domain.com --\u003e domain.com",
            "etag": "ETVPDKIKX0DER",
            "id": "site-canonical-function",
